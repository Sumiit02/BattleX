    # Flask
    FLASK_ENV=production
    FLASK_DEBUG=0
    SECRET_KEY=change-this-in-production
    SESSION_COOKIE_SECURE=1
    APP_TIMEZONE=Asia/Kolkata
    APP_BASE_URL=
    CASHFREE_RETURN_BASE_URL=

    # Database and uploads (Render persistent disk)
    DB_NAME=/var/data/gamezone.db
    UPLOAD_DIR=/var/data/uploads

    # PostgreSQL (recommended on Render)
    DATABASE_URL=
    PGSSLMODE=require

    # Cashfree
    CASHFREE_ENV=sandbox
    CASHFREE_APP_ID=
    CASHFREE_SECRET_KEY=
    CASHFREE_WEBHOOK_SECRET=
    CASHFREE_WEBHOOK_REQUIRE_SIGNATURE=1
    CASHFREE_API_VERSION=2023-08-01

    # Cashfree Payouts (required for automatic bank/UPI withdrawals)
    CASHFREE_PAYOUTS_ENABLED=0
    CASHFREE_PAYOUTS_BASE_URL=
    CASHFREE_PAYOUTS_CLIENT_ID=
    CASHFREE_PAYOUTS_SECRET_KEY=
    CASHFREE_PAYOUTS_REQUEST_PATH=/requestTransfer
    CASHFREE_PAYOUTS_STATUS_PATH=/getTransferStatus
    CASHFREE_PAYOUTS_WEBHOOK_SECRET=
    CASHFREE_PAYOUTS_REQUIRE_SIGNATURE=1
    CASHFREE_PAYOUTS_SOURCE=battlex
    CASHFREE_PAYOUTS_METHOD_BANK=banktransfer
    CASHFREE_PAYOUTS_METHOD_UPI=upi

    # Google OAuth
    GOOGLE_CLIENT_ID=
    GOOGLE_CLIENT_SECRET=
    GOOGLE_REDIRECT_URI=
    GOOGLE_OAUTH_CREDENTIALS_FILE=
