# Flask
FLASK_ENV=production
FLASK_DEBUG=0
SECRET_KEY=change-this-in-production
SESSION_COOKIE_SECURE=1
APP_TIMEZONE=Asia/Kolkata

# Database and uploads (Render persistent disk)
DB_NAME=/var/data/gamezone.db
UPLOAD_DIR=/var/data/uploads

# PostgreSQL (recommended on Render)
DATABASE_URL=
PGSSLMODE=require

# Cashfree
CASHFREE_ENV=sandbox
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_CREDENTIALS_FILE=
